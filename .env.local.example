NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, used for admin/service-role operations. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client ID/secret are NOT set here — they live in the
# Supabase dashboard (Authentication > Sign In / Providers > Google), not
# in this app's env vars.

# Second layer on top of Google + role='admin' before /admin renders
# anything. Pick any value; never commit the real one. Not set = /admin
# fails closed (no one gets in, admin role or not) until this is set.
ADMIN_PASSCODE=
